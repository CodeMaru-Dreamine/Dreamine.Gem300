<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Dreamine.Gem300</AssemblyName><RootNamespace>Dreamine.Gem300</RootNamespace>
    <PackageId>Dreamine.Gem300</PackageId><Version>1.0.1</Version><Authors>Dreamine Core Team</Authors><Company>Dreamine</Company>
    <Description>Dreamine GEM300 domain runtime with integrity-safe carrier, substrate, job, object, and event workflows.</Description>
    <PackageReleaseNotes>1.0.1: makes the QuickStart package-first, improves NuGet onboarding, adds standalone repository builds, CI and SonarQube Cloud analysis, and portable symbols with Source Link metadata.</PackageReleaseNotes>
    <PackageTags>dreamine;gem300;gem;runtime;equipment</PackageTags><PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem300</RepositoryUrl><Title>Dreamine.Gem300</Title>
    <Copyright>© 2026 Dreamine Core Team. All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Gem300</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild><GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="\" /><None Include="icon.png" Pack="true" PackagePath="\" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
    <EmbeddedResource Remove="samples\**\*" />
    <None Remove="samples\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gem300.Abstractions\Dreamine.Gem300.Abstractions.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Gem300.Abstractions\Dreamine.Gem300.Abstractions.csproj')" />
    <ProjectReference Include="..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj')" />
    <ProjectReference Include="..\Gem\Dreamine.Gem.csproj" Condition="'$(UseLocalDreamineSources)' != 'false' And Exists('..\Gem\Dreamine.Gem.csproj')" />
    <PackageReference Include="Dreamine.Gem300.Abstractions" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Gem300.Abstractions\Dreamine.Gem300.Abstractions.csproj')" />
    <PackageReference Include="Dreamine.Gem.Abstractions" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Gem.Abstractions\Dreamine.Gem.Abstractions.csproj')" />
    <PackageReference Include="Dreamine.Gem" Condition="'$(UseLocalDreamineSources)' == 'false' Or !Exists('..\Gem\Dreamine.Gem.csproj')" />
  </ItemGroup>
</Project>
